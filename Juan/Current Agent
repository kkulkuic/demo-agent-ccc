async def dismiss_cookie_consent(page) -> None:
    candidates = [
        "button:has-text('Accept')",
        "button:has-text('I agree')",
        "button:has-text('Allow all')",
        "button:has-text('Accept all')",
        "button:has-text('Got it')",
        "button:has-text('OK')",
        "button:has-text('Continue')",
        "button:has-text('Agree')",
        "button:has-text('Accept cookies')",
        "button:has-text('Allow cookies')",
        "text=Accept",
        "text=I agree",
        "text=Allow all",
        "text=Accept all",
        "text=Continue",
    ]

    for selector in candidates:
        try:
            locator = page.locator(selector).first
            visible = await locator.is_visible(timeout=800)
            if visible:
                await locator.click(timeout=1500)
                await page.wait_for_timeout(500)
                return
        except Exception:
            continue


async def safe_page_snapshot(page, max_chars: int = 3000) -> dict:
    title = ""
    body_sample = ""
    url = ""

    try:
        title = (await page.title() or "").strip()
    except Exception:
        title = ""

    try:
        url = page.url
    except Exception:
        url = ""

    try:
        body_sample = (await page.locator("body").inner_text(timeout=5000) or "")[:max_chars]
    except Exception:
        body_sample = ""

    return {
        "url": url,
        "title": title,
        "body_sample": body_sample,
    }


async def looks_like_bot_challenge() -> dict:
    page = await get_session()

    try:
        body_text = (await page.locator("body").inner_text(timeout=4000) or "").lower()
    except Exception:
        body_text = ""

    try:
        title = (await page.title() or "").lower()
    except Exception:
        title = ""

    try:
        url = (page.url or "").lower()
    except Exception:
        url = ""

    triggers = [
        "unusual traffic",
        "not a robot",
        "captcha",
        "verify you are human",
        "verify you are a human",
        "press and hold",
        "cloudflare",
        "checking your browser",
        "access denied",
    ]

    haystack = f"{title}\n{url}\n{body_text}"
    matched = [t for t in triggers if t in haystack]

    return {
        "ok": True,
        "is_bot_challenge": len(matched) > 0,
        "matched_triggers": matched,
        "url": url,
        "title": title,
        "body_sample": body_text[:1500],
    }


def detect_login_wall(snapshot: dict) -> bool:
    text = (
        f"{snapshot.get('title', '')}\n"
        f"{snapshot.get('url', '')}\n"
        f"{snapshot.get('body_sample', '')}"
    ).lower()

    login_terms = [
        "sign in",
        "log in",
        "login",
        "enter your password",
        "authentication required",
        "continue with google",
        "continue with email",
    ]

    blocking_terms = [
        "to continue",
        "to view this page",
        "access denied",
        "please sign in",
        "please log in",
        "you must be logged in",
        "restricted access",
        "members only",
        "not authorized",
    ]

    has_login = any(term in text for term in login_terms)
    has_blocking = any(term in text for term in blocking_terms)

    return has_login and has_blocking


async def install_red_dot(page) -> None:
    await page.evaluate(
        """
        () => {
            if (document.getElementById('__agent_red_dot__')) return;
            const dot = document.createElement('div');
            dot.id = '__agent_red_dot__';
            dot.style.position = 'fixed';
            dot.style.width = '14px';
            dot.style.height = '14px';
            dot.style.borderRadius = '50%';
            dot.style.background = 'red';
            dot.style.zIndex = '2147483647';
            dot.style.pointerEvents = 'none';
            dot.style.left = '0px';
            dot.style.top = '0px';
            dot.style.boxShadow = '0 0 10px rgba(255,0,0,0.8)';
            document.body.appendChild(dot);
        }
        """
    )


async def move_red_dot(page, x: float, y: float) -> None:
    await page.evaluate(
        """
        ([x, y]) => {
            const dot = document.getElementById('__agent_red_dot__');
            if (!dot) return;
            dot.style.left = `${x - 7}px`;
            dot.style.top = `${y - 7}px`;
        }
        """,
        [x, y]
    )


async def clear_agent_highlights(page) -> None:
    try:
        await page.evaluate(
            """
            () => {
                document.querySelectorAll('[data-agent-highlight="1"]').forEach(el => {
                    el.style.outline = '';
                    el.style.outlineOffset = '';
                    el.removeAttribute('data-agent-highlight');
                });
            }
            """
        )
    except Exception:
        pass


