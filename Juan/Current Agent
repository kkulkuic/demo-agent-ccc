@tool
async def get_accessibility_tree():
    """
    BENCHMARK TOOL. Returns the browser accessibility tree as structured text.
    Gives stable element references (role, name, value) for reliable interaction
    without depending on fragile CSS selectors.
    """
    page = await get_session()
    try:
        snapshot = await page.accessibility.snapshot()

        def flatten(node, depth=0):
            if node is None:
                return []
            lines = []
            role = node.get("role", "")
            name = node.get("name", "")
            value = node.get("value", "")
            if role not in ("none", "presentation", "generic", ""):
                parts = [f"{'  ' * depth}[{role}]"]
                if name:
                    parts.append(f'"{name}"')
                if value:
                    parts.append(f'= "{value}"')
                lines.append(" ".join(parts))
            for child in node.get("children", []):
                lines.extend(flatten(child, depth + 1))
            return lines

        tree_lines = flatten(snapshot)
        tree_text = "\n".join(tree_lines[:300])
        return await enrich_result("a11y", {"status": "success", "accessibility_tree": tree_text})
    except Exception as e:
        return {"error": str(e)}


