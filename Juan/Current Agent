browser_session = {"playwright": None, "context": None, "page": None}


async def get_session():
    if browser_session["playwright"] is None:
        print("🌐 Starting Stealth Playwright browser...")
        browser_session["playwright"] = await async_playwright().start()
        browser_session["context"] = await browser_session["playwright"].chromium.launch_persistent_context(
            user_data_dir="playwright/.auth",
            headless=False,
            channel="chrome",
            locale="en-US",
            timezone_id="America/Chicago",
            extra_http_headers={"Accept-Language": "en-US,en;q=0.9"}
        )
        existing_pages = browser_session["context"].pages
        page = existing_pages[0] if existing_pages else await browser_session["context"].new_page()
        stealth = Stealth()
        await stealth.apply_stealth_async(page)
        browser_session["page"] = page
    return browser_session["page"]


