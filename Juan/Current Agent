@tool
async def list_clickable_elements(max_items: int = 40, min_text_len: int = 1):
    """
    BENCHMARK TOOL. List likely clickable visible elements and tag them with indices.
    Useful fallback when CSS selectors are unreliable.
    """
    page = await get_session()

    try:
        await dismiss_cookie_consent(page)
        await page.wait_for_timeout(300)

        items = await page.evaluate(
            """
            ([maxItems, minTextLen]) => {
                const selectors = [
                    'a[href]',
                    'button',
                    'input[type="button"]',
                    'input[type="submit"]',
                    'input[type="reset"]',
                    '[role="button"]',
                    '[role="link"]',
                    '[role="menuitem"]',
                    '[role="tab"]',
                    '[onclick]',
                    'summary',
                    'label'
                ];

                const seen = new Set();
                const elements = [];

                function isVisible(el) {
                    const rect = el.getBoundingClientRect();
                    const style = window.getComputedStyle(el);
                    return (
                        rect.width > 0 &&
                        rect.height > 0 &&
                        style.visibility !== 'hidden' &&
                        style.display !== 'none'
                    );
                }

                function cleanText(text) {
                    return (text || '').replace(/\\s+/g, ' ').trim();
                }

                function cssPath(el) {
                    if (!(el instanceof Element)) return '';
                    const path = [];
                    let current = el;

                    while (current && current.nodeType === Node.ELEMENT_NODE && path.length < 5) {
                        let selector = current.nodeName.toLowerCase();

                        if (current.id) {
                            selector += '#' + current.id;
                            path.unshift(selector);
                            break;
                        }

                        const classList = [...current.classList].slice(0, 2).join('.');
                        if (classList) {
                            selector += '.' + classList;
                        }

                        const parent = current.parentElement;
                        if (parent) {
                            const siblings = [...parent.children].filter(
                                child => child.nodeName === current.nodeName
                            );
                            if (siblings.length > 1) {
                                const index = siblings.indexOf(current) + 1;
                                selector += `:nth-of-type(${index})`;
                            }
                        }

                        path.unshift(selector);
                        current = current.parentElement;
                    }

                    return path.join(' > ');
                }

                const candidates = document.querySelectorAll(selectors.join(','));

                for (const el of candidates) {
                    if (elements.length >= maxItems) break;
                    if (!isVisible(el)) continue;

                    const rect = el.getBoundingClientRect();
                    const text = cleanText(
                        el.innerText ||
                        el.textContent ||
                        el.getAttribute('aria-label') ||
                        el.getAttribute('title') ||
                        el.getAttribute('value') ||
                        ''
                    );

                    const role = el.getAttribute('role') || '';
                    const tag = el.tagName.toLowerCase();
                    const href = el.getAttribute('href') || '';
                    const selector = cssPath(el);

                    const dedupeKey = `${tag}|${text}|${selector}|${Math.round(rect.x)}|${Math.round(rect.y)}`;
                    if (seen.has(dedupeKey)) continue;
                    seen.add(dedupeKey);

                    if (text.length < minTextLen && !href && !role) continue;

                    el.setAttribute('data-agent-index', String(elements.length + 1));

                    elements.push({
                        index: elements.length + 1,
                        text: text.slice(0, 120),
                        tag,
                        role,
                        href,
                        selector,
                        x: Math.round(rect.x),
                        y: Math.round(rect.y),
                        width: Math.round(rect.width),
                        height: Math.round(rect.height),
                    });
                }

                return elements;
            }
            """,
            [max_items, min_text_len]
        )

        return await enrich_result(
            "clickables",
            {"status": "success", "count": len(items), "elements": items}
        )
    except Exception as e:
        return {"error": str(e)}


@tool
async def highlight_element_index(index: int):
    """
    BENCHMARK TOOL. Highlight a previously indexed clickable element.
    Run list_clickable_elements first.
    """
    page = await get_session()
    try:
        await clear_agent_highlights(page)

        locator = page.locator(f'[data-agent-index="{index}"]').first
        if not await locator.is_visible(timeout=1500):
            return {"error": f"Could not find visible element with index {index}. Run list_clickable_elements first."}

        await install_red_dot(page)
        box = await locator.bounding_box()
        if box:
            await move_red_dot(page, box["x"] + box["width"] / 2, box["y"] + box["height"] / 2)

        await locator.evaluate(
            """
            el => {
                el.setAttribute('data-agent-highlight', '1');
                el.style.outline = '4px solid red';
                el.style.outlineOffset = '3px';
            }
            """
        )

        await page.wait_for_timeout(500)

        text = ""
        try:
            text = (await locator.inner_text(timeout=1000) or "").strip()
        except Exception:
            text = ""

        return await enrich_result(
            "highlight_index",
            {"status": "highlighted", "index": index, "text": text[:120]}
        )
    except Exception as e:
        return {"error": str(e)}


@tool
async def click_element_by_index(index: int):
    """
    BENCHMARK TOOL. Click a previously indexed clickable element.
    Run list_clickable_elements first.
    """
    page = await get_session()
    try:
        locator = page.locator(f'[data-agent-index="{index}"]').first
        if not await locator.is_visible(timeout=1500):
            return {"error": f"Could not find visible element with index {index}. Run list_clickable_elements first."}

        await install_red_dot(page)
        box = await locator.bounding_box()
        if box:
            await move_red_dot(page, box["x"] + box["width"] / 2, box["y"] + box["height"] / 2)
            await page.wait_for_timeout(350)

        text = ""
        try:
            text = (await locator.inner_text(timeout=1000) or "").strip()
        except Exception:
            text = ""

        await locator.click(timeout=5000)
        await page.wait_for_timeout(1200)
        await dismiss_cookie_consent(page)

        return await enrich_result(
            "click_index",
            {"status": "clicked indexed element", "index": index, "text": text[:120]}
        )
    except Exception as e:
        return {"error": str(e)}


