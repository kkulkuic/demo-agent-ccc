base_tool_node = ToolNode(tools)

# ─────────────────────────────────────────────
# 7. STATE & AGENT
# ─────────────────────────────────────────────

class State(TypedDict, total=False):
    messages: Annotated[list[BaseMessage], add_messages]

    # task tracking
    task_goal: Optional[str]
    current_step: Optional[str]

    # execution tracking
    attempt_count: int
    last_tool: Optional[str]
    last_tool_result: Optional[dict]
    blocked_reason: Optional[str]
    done: bool

    # page + context
    context: dict[str, Any]
    page_stall_count: int
    last_url: Optional[str]
    last_title: Optional[str]

    # history
    action_history: list[dict[str, Any]]

    # metrics
    total_steps: int
    fallback_count: int
    success_count: int
    failure_count: int

SYSTEM_PROMPT = """You are a Browser Navigation Agent. You control a real Chrome browser to complete tasks on live websites.

━━ PRIMARY GOAL ━━
Focus on task completion and flow reliability.
Use tools in a grounded, step-by-step way.
Do not guess. Only claim what you can verify from tool outputs.

━━ VISION ━━
Most tools return screenshot_b64 and page text/state.
After every action, verify:
- the page changed as expected
- no modal, error, CAPTCHA, or login wall appeared
- the target is still correct

━━ AVAILABLE STRATEGIES ━━
Basic browser actions:
- browser_navigate
- browser_click
- browser_fill
- browser_fill_search     → use this when a search box is visible but click/fill keeps failing
- browser_scroll
- browser_select
- browser_hover
- browser_key_press
- browser_go_back
- browser_get_text
- browser_wait
- browser_inspect

Fallback / recovery tools:
- get_accessibility_tree
- list_clickable_elements
- highlight_element_index
- click_element_by_index
- browser_click_coords
- browser_highlight



━━ TOOL PRIORITY ━━
1. Navigate or inspect current page.
2. Try direct selector-based action first.
3. If selector is unreliable, use:
   - get_accessibility_tree
   - list_clickable_elements
   - highlight_element_index
   - click_element_by_index
4. If page is slow, use browser_wait.
5. If clearly done, call stop(answer).
6. If a search box is visible but direct click or selector-based fill fails, use browser_fill_search.

━━ FAILURE POLICY ━━
If the same action approach keeps failing:
- switch strategy instead of repeating blindly
- after repeated failures or block conditions, ask the human
If you repeat the same discovery tools (accessibility tree, clickable elements, inspect) without progress, switch strategies instead of repeating.

━━ WHEN TO ASK THE HUMAN ━━
- CAPTCHA or bot challenge
- login wall requiring credentials
- ambiguous target choice
- repeated action failure after fallback attempts
- a required decision is subjective and not visible

When asking, be short and structured:
- what you tried
- what blocked you
- what you need from the human

━━ COMPLETION RULE ━━
When you have the final answer, you MUST call stop(answer) instead of replying normally.
Do not end with a normal assistant message when the task is complete."""

llm = ChatAnthropic(
    model=MODEL_ID,
    api_key=os.getenv("ANTHROPIC_API_KEY"),
    temperature=0
).bind_tools(tools)


def parse_tool_content(raw_content: Any) -> dict:
    if isinstance(raw_content, dict):
        content = dict(raw_content)
    elif isinstance(raw_content, list):
        content = raw_content[0] if raw_content and isinstance(raw_content[0], dict) else {"raw": raw_content}
    else:
        return {"raw": str(raw_content)}

    # 🚨 REMOVE HEAVY FIELDS
    content.pop("screenshot_b64", None)

    # truncate large text fields
    if "body_sample" in content:
        content["body_sample"] = content["body_sample"][:1000]

    if "content" in content:
        content["content"] = content["content"][:1000]

    if "accessibility_tree" in content:
        content["accessibility_tree"] = content["accessibility_tree"][:1500]

    return content


def classify_result_status(result: dict) -> str:
    if not isinstance(result, dict):
        return "unknown"

    if result.get("error"):
        return "failed"

    status = str(result.get("status", "")).lower()
    if "stopped" in status:
        return "done"
    if "success" in status or "clicked" in status or "filled" in status or "selected" in status:
        return "success"
    if "waited" in status or "visual captured" in status or "hovered" in status or "highlighted" in status:
        return "partial"

    return "partial"


async def evaluate_page_blockers() -> tuple[Optional[str], dict]:
    page = await get_session()
    snapshot = await safe_page_snapshot(page, max_chars=2000)
    bot = await looks_like_bot_challenge()

    if bot.get("is_bot_challenge"):
        return f"Bot challenge detected: {', '.join(bot.get('matched_triggers', []))}", snapshot

    if detect_login_wall(snapshot):
        return "Login wall detected", snapshot

    return None, snapshot

def choose_forced_fallback(state: State) -> Optional[dict]:
    """
    Force a smarter next tool when the agent is looping or an action failed.
    Returns a tool call dict like:
    {"name": "list_clickable_elements", "args": {"max_items": 40}}
    """
    last_tool = state.get("last_tool")
    last_result = state.get("last_tool_result") or {}
    attempt_count = state.get("attempt_count", 0)
    action_history = state.get("action_history", [])

    recent_tools = [h.get("tool") for h in action_history[-6:]]

    # Search-box loop breaker
    search_loop_count = sum(
        t in {"browser_click", "list_clickable_elements", "get_accessibility_tree", "browser_inspect"}
        for t in recent_tools
    )
    if search_loop_count >= 5:
        return {
            "name": "browser_fill_search",
            "args": {"text": "Chicago"}  # will be overridden only if user task is different later
        }

    # Direct click failed repeatedly -> switch to clickable list
    if last_tool == "browser_click" and attempt_count >= 1:
        return {
            "name": "list_clickable_elements",
            "args": {"max_items": 40}
        }

    # If clickable list already happened, try indexed click if possible
    if last_tool == "list_clickable_elements":
        elements = last_result.get("elements", [])
        if elements:
            return {
                "name": "click_element_by_index",
                "args": {"index": 1}
            }

    # If indexed click failed, inspect
    if last_tool == "click_element_by_index" and attempt_count >= 1:
        return {
            "name": "browser_inspect",
            "args": {}
        }

    return None

def build_forced_tool_ai_message(tool_name: str, args: dict) -> AIMessage:
    return AIMessage(
        content="",
        additional_kwargs={
            "tool_calls": [
                {
                    "id": f"toolu_{int(time.time()*1000)}",
                    "type": "tool_use",
                    "name": tool_name,
                    "input": args,
                }
            ]
        },
    )


async def tools_node(state: State):
    result = await base_tool_node.ainvoke(state)

    tool_msgs = result.get("messages", [])
    if not tool_msgs:
        return result

    last_msg = tool_msgs[-1]
    tool_name = getattr(last_msg, "name", "unknown")
    parsed = parse_tool_content(getattr(last_msg, "content", {}))
    result_status = classify_result_status(parsed)

    blocked_reason, snapshot = await evaluate_page_blockers()

    # ✅ Only block if action failed OR page is clearly unusable
    if blocked_reason and result_status == "success":
        blocked_reason = None

    previous_tool = state.get("last_tool")
    previous_url = state.get("last_url")
    attempt_count = state.get("attempt_count", 0)
    page_stall_count = state.get("page_stall_count", 0)
    done = state.get("done", False)

    if previous_tool == tool_name and result_status == "failed":
        attempt_count += 1
    elif result_status == "failed":
        attempt_count = 1
    else:
        attempt_count = 0

    current_url = snapshot.get("url")
    current_title = snapshot.get("title")

    # ✅ Only count stalls for REAL ACTIONS (not inspection tools)
    ACTION_TOOLS = {
        "browser_click",
        "browser_fill",
        "browser_select",
        "browser_click_coords",
        "click_element_by_index",
        "browser_key_press",
        "browser_go_back",
    }

    if (
        tool_name in ACTION_TOOLS
        and current_url
        and previous_url
        and current_url == previous_url
        and result_status in {"partial", "failed"}
    ):
        page_stall_count += 1
    else:
        page_stall_count = 0

    if not isinstance(parsed, dict):
        parsed = {}

    if result_status == "done" or parsed.get("status") == "stopped":
        done = True
    if done:
        run_data = {
            "timestamp": datetime.now().isoformat(),
            "question": state.get("task_goal"),
            "answer": parsed.get("answer"),
            "steps": state.get("total_steps", 0),
            "fallbacks": state.get("fallback_count", 0),
            "success_steps": state.get("success_count", 0),
            "failed_steps": state.get("failure_count", 0),
            "actions": state.get("action_history", []),
        }

        print("📝 done=True, writing log now...")
        log_run(run_data)

    

    context = dict(state.get("context", {}))
    context["last_status"] = result_status
    context["last_snapshot"] = snapshot
    context["last_tool_name"] = tool_name

    history = list(state.get("action_history", []))
    history.append(
        {
            "tool": tool_name,
            "status": result_status,
            "url": current_url,
            "title": current_title,
            "error": parsed.get("error"),
        }
    )
    history = history[-12:]

    if attempt_count >= 2 and not blocked_reason and parsed.get("error"):
        blocked_reason = f"Repeated failure using {tool_name}: {parsed.get('error')}"

    total_steps = state.get("total_steps", 0) + 1
    fallback_count = state.get("fallback_count", 0)
    success_count = state.get("success_count", 0)
    failure_count = state.get("failure_count", 0)

    if tool_name in {
        "get_accessibility_tree",
        "list_clickable_elements",
        "highlight_element_index",
        "click_element_by_index",
        "browser_click_coords",
        "browser_inspect",
        "browser_fill_search",
    }:
        fallback_count += 1

    if result_status in {"success", "done"}:
        success_count += 1
    elif result_status == "failed":
        failure_count += 1

    if page_stall_count >= 3 and not blocked_reason:
        blocked_reason = "Page state appears stalled after repeated actions"

    return {
        **result,
        "last_tool": tool_name,
        "last_tool_result": parsed,
        "attempt_count": attempt_count,
        "blocked_reason": blocked_reason,
        "done": done,
        "context": context,
        "last_url": current_url,
        "last_title": current_title,
        "page_stall_count": page_stall_count,
        "action_history": history,
        "total_steps": total_steps,
        "fallback_count": fallback_count,
        "success_count": success_count,
        "failure_count": failure_count,
    }


async def agent_node(state: State):
    # Forced fallback first
    forced = choose_forced_fallback(state)
    if forced:
        print(f"\n🟡 [Forced Fallback]: {forced['name']} {forced['args']}")
        return {
            "messages": [build_forced_tool_ai_message(forced["name"], forced["args"])]
        }

    execution_note = {
        "task_goal": state.get("task_goal"),
        "current_step": state.get("current_step"),
        "last_tool": state.get("last_tool"),
        "attempt_count": state.get("attempt_count", 0),
        "blocked_reason": state.get("blocked_reason"),
        "last_url": state.get("last_url"),
        "last_title": state.get("last_title"),
        "last_tool_result": state.get("last_tool_result"),
        "page_stall_count": state.get("page_stall_count", 0),
    }

    MAX_HISTORY = 4
    trimmed_history = state["messages"][-MAX_HISTORY:]

    messages = [
        SystemMessage(content=SYSTEM_PROMPT),
        SystemMessage(
            content=f"Execution state:\n{json.dumps(execution_note, ensure_ascii=False, default=str)}"
        ),
    ] + trimmed_history

    response = await llm.ainvoke(messages)

    # Auto-stop guard
    has_tool_calls = bool(getattr(response, "tool_calls", None))

    text_content = ""
    if isinstance(response.content, str):
        text_content = response.content.strip()
    elif isinstance(response.content, list):
        parts = []
        for block in response.content:
            if isinstance(block, dict) and block.get("type") == "text":
                parts.append(block.get("text", ""))
        text_content = "\n".join(parts).strip()

    if not has_tool_calls and text_content:
        print("⚡ Auto-converting final text response into stop()")

        return {
            "messages": [
                build_forced_tool_ai_message(
                    "stop",
                    {"answer": text_content}
                )
            ]
        }

    if isinstance(response.content, str) and response.content.strip():
        print(f"\n🟢 [Agent]:\n{response.content}")
    elif isinstance(response.content, list):
        for block in response.content:
            if isinstance(block, dict) and block.get("type") == "text" and block["text"].strip():
                print(f"\n🟢 [Agent]:\n{block['text']}")

    return {"messages": [response]}

def human_input_node(state: State):
    reason = state.get("blocked_reason")
    prompt = "Waiting for your input:"
    if reason:
        prompt = f"Agent needs help. Reason: {reason}\nPlease respond:"

    user_input = interrupt(prompt)

    return {
        "messages": [HumanMessage(content=user_input)],
        "attempt_count": 0,
        "blocked_reason": None,
        "page_stall_count": 0,
        "current_step": "resumed after human input",
    }

def router(state: State):
    """
    Decide what happens after the agent speaks.
    """

    # If task is done → END
    if state.get("done"):
        return "end"

    # If blocked → ask human
    if state.get("blocked_reason"):
        return "human_input"

    # If agent produced a tool call → go to tools
    last_msg = state.get("messages", [])[-1]
    if isinstance(last_msg, AIMessage) and getattr(last_msg, "tool_calls", None):
        return "tools"

    # Default → keep reasoning
    return "agent"


# ─────────────────────────────────────────────
# 8. BUILD GRAPH
# ─────────────────────────────────────────────

workflow = StateGraph(State)
workflow.add_node("agent", agent_node)
workflow.add_node("tools", tools_node)
workflow.add_node("human_input", human_input_node)

workflow.add_edge(START, "agent")
workflow.add_conditional_edges(
    "agent",
    router,
    {
        "tools": "tools",
        "human_input": "human_input",
        "end": "__end__",
    },
)
workflow.add_edge("tools", "agent")
workflow.add_edge("human_input", "agent")

app = workflow.compile(checkpointer=InMemorySaver())

# ─────────────────────────────────────────────
# 9. MAIN LOOP (HITL)
# ─────────────────────────────────────────────

async def stream_run(input_data, config):
    async for event in app.astream(input_data, config, stream_mode="updates"):
        for node, data in event.items():
            if node == "tools":
                msgs = data.get("messages", [])
                if msgs:
                    tool_name = getattr(msgs[-1], "name", "tool")
                    print(f"  🔧 [{tool_name}] executed")
                    blocked_reason = data.get("blocked_reason")
                    if blocked_reason:
                        print(f"  ⚠️ Blocked: {blocked_reason}")
            elif node == "agent":
                if data.get("done"):
                    print("  ✅ Agent marked task complete.")


async def main():
    config = {"configurable": {"thread_id": "nav-session"}}

    print("\n" + "═" * 58)
    print("  🌐  BROWSER NAVIGATION AGENT  (Improved Arena Flow)")
    print("═" * 58)
    print("  Added state tracking, retry handling, blockers, and HITL.")
    print("  Type 'exit' at any time to quit.")
    print("─" * 58)

    initial_prompt = input("\n[Task]: ").strip()
    if not initial_prompt or initial_prompt.lower() == "exit":
        print("Exiting.")
        return

    initial_state: State = {
        "messages": [HumanMessage(content=initial_prompt)],
        "task_goal": initial_prompt,
        "current_step": "start",
        "attempt_count": 0,
        "last_tool": None,
        "last_tool_result": None,
        "blocked_reason": None,
        "done": False,
        "context": {},
        "page_stall_count": 0,
        "last_url": None,
        "last_title": None,
        "action_history": [],
        "total_steps": 0,
        "fallback_count": 0,
        "success_count": 0,
        "failure_count": 0,
    }

    print("\n⏳ Starting...\n")
    await stream_run(initial_state, config)

    while True:
        user_cmd = input("\n[Your reply / 'exit']: ").strip()

        if user_cmd.lower() == "exit":
            print("\nShutting down...")
            break

        if not user_cmd:
            user_cmd = "Please continue."

        print("\n⏳ Resuming...\n")
        try:
            await stream_run(Command(resume=user_cmd), config)
        except Exception as e:
            print(f"❌ Error: {e}")
            break

    if browser_session["context"]:
        print("🧹 Closing browser...")
        await browser_session["context"].close()
    if browser_session["playwright"]:
        await browser_session["playwright"].stop()

    print("\n✅ Session ended.")


if __name__ == "__main__":
    try:
        asyncio.run(main())
    except KeyboardInterrupt:
        print("\n⚠️ Interrupted.")
