async def capture(prefix: str) -> dict:
    page = await get_session()
    path = f"logs/{prefix}_{int(time.time())}.png"
    await page.screenshot(path=path)
    with open(path, "rb") as f:
        img_b64 = base64.b64encode(f.read()).decode("utf-8")
    return {"screenshot_path": path, "screenshot_b64": img_b64}


async def enrich_result(prefix: str, extra: Optional[dict] = None) -> dict:
    page = await get_session()
    snapshot = await safe_page_snapshot(page)
    ss = await capture(prefix)
    result = {}
    if extra:
        result.update(extra)
    result.update(snapshot)
    result.update(ss)
    result.pop("screenshot_b64", None)

    return result


